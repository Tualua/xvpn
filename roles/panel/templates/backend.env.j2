# {{ ansible_managed }}
APP_PORT=3000
METRICS_PORT=3001
DATABASE_URL=postgresql://{{ xvpn_panel_postgres_user }}:{{ xvpn_panel_secrets.postgres_password }}@remnawave-db:5432/{{ xvpn_panel_postgres_db }}
REDIS_SOCKET=/var/run/valkey/valkey.sock
APP_SECRET={{ xvpn_panel_secrets.app_secret }}
JWT_AUTH_LIFETIME={{ xvpn_panel_jwt_auth_lifetime }}
# CORS origin only (credentials are off, the UI is served same-origin), so * does not widen the gate
FRONT_END_DOMAIN=*
PANEL_DOMAIN={{ xvpn_panel_domain }}
SUB_PUBLIC_DOMAIN={{ xvpn_subscription_domain if (xvpn_panel_subscription_enabled | bool) else xvpn_panel_domain ~ '/api/sub' }}
METRICS_USER={{ xvpn_panel_secrets.metrics_user }}
METRICS_PASS={{ xvpn_panel_secrets.metrics_password }}
